# Exclude Git files and history
.git/
.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# OS generated files
.DS_Store
Thumbs.db

# Environment & config
.env
*.env

# Editor & IDE settings
.vscode/
.idea/

# Logs & databases
*.log
*.sqlite3

# Test artifacts
coverage.xml
htmlcov/

# Temporary files / folders
temp*
*.tmp

# Audio generated by TTS
*.wav
audio/

# Node & frontend caches
node_modules/
frontend/node_modules/

# Python build artifacts
dist/
build/

# Jupyter notebooks
*.ipynb
